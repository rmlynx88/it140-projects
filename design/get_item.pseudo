IF item exists in current_room AND item not collected:
    PROMPT player to get item (yes/no)
    GET user_input
    IF user_input == "yes":
        ADD item to player_inventory
        MARK item as collected
        PRINT "Item added."
    ELSE:
        PRINT "Item left behind."
    ENDIF
ELSE:
    PRINT "No items here."
ENDIF
