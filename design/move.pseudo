WHILE player has not won or lost:
    PROMPT player for direction command (north, south, east, west)
    GET user_input
    IF user_input is a valid direction:
        IF path exists:
            UPDATE current_room
            IF current_room is villain room AND items collected < 6:
                PRINT "You lose!"
                BREAK
            ELSE IF current_room is villain room AND items collected == 6:
                PRINT "You win!"
                BREAK
            ENDIF
        ELSE:
            PRINT "You cannot go that way."
        ENDIF
    ELSE:
        PRINT "Invalid input."
    ENDIF
ENDWHILE
